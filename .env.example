# Copy to .env and fill in. Never commit your real .env (it is gitignored).

# Anthropic API key. Alternatively run `ant auth login` and omit this —
# the SDK resolves credentials from the environment or your auth profile.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown):
# ALARM_MODEL=claude-opus-5-5
# ALARM_EFFORT=medium
# ALARM_MAX_TOKENS=4096
